<%- include('../inc/header.ejs') %> <%- include('../inc/nav_header.ejs') %>

<style>
    .user-avatar {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 50%;
}

</style>
<div class="col-md-12 col-sm-12">
    
      <div class="form-block">
       
        <div class="form-block-body">
          
          <div class="form-group">
            <label>Tiêu đề tin: </label>
          <span><%= jobs.title %></span>
          </div>
          <div class="form-group">
            <label>Mô tả: </label>
            <span><%= jobs.desc %></span>
           
          </div>
         
          <div class="form-group">
            <label>Lĩnh vực: </label>
<span><%= jobs.majors %></span>
           
          </div>
          <div class="form-group">
            <label>Số lượng: </label>
<span><%= jobs.number_of_recruitments %></span>
          
          </div>
          <div class="form-group">
            <label> Yêu cầu: </label>
            <span><%= jobs.requirements %></span>
           
            
          </div>
          <div class="form-group">
            <label>Mức lương:</label>
        
            <span><%= jobs.salary %></span>
           
          </div>
          <div class="form-group">
            <label>Quyền lợi:</label>
        
            <span><%= jobs.benefits %></span>
           
          </div>

          <div class="form-group">
            <label> Địa chỉ làm việc: </label>
            <span><%= jobs.location %></span>
           
            
          </div>
          <div class="form-group">
            <label> Hạn nộp hồ sơ: </label>
           
            <button type="button" class="btn btn-danger" >
              <%= jobs.deadline %>
              
          
            </button>
            
          </div>
         

         
        </div>
    
      
      
      </div>
      
      
  </div>
  
  <%- include('../inc/nav_footer.ejs') %> <%- include('../inc/footer.ejs') %>