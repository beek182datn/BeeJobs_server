<%- include('../inc/header.ejs') %> 
<%- include('../inc/nav_header.ejs') %>

<!-- section container start -->
<div class="section-container">
  <p class="section-title">Danh sách tin tuyển dụng</p>

  <form action="" method="GET" class="mb-3">
    <div class="input-group">
      <input type="text" class="form-control" placeholder="Tìm kiếm tin tuyển dụng..." name="search" value="<%= search %>">
      <div class="input-group-append">
        <button class="btn btn-outline-secondary" type="submit">Tìm kiếm</button>
      </div>
    </div>
  </form>

  <div class="table-responsive">
    <table class="table m-0">
      <thead>
        <tr>
          <th>STT</th>
          <th>Tiêu đề</th>
          <th style="width: 13%;">Mô tả</th>
          <th>Công ty đăng tin</th>
          <th>Số người ứng tuyển</th>
        <th>Thời hạn đăng tin</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% list.forEach((lstJobs, index) => { %>
        <tr>
          <td>
            <span class="text-info"><%= (currentPage - 1) * limit + index + 1 %></span>
          </td>
          <td><%= lstJobs.title %></td>
          <td><%= lstJobs.desc %></td>
          <td><%= lstJobs.companyName %></td>
          <td><%= lstJobs.applicationsCount %></td>

          <td><%= lstJobs.expires_at_formatted %></td>

          <td>
            <% if(lstJobs.status == "LOCK"){ %>
            <span class="badge badge-pill badge-danger">Bị khóa</span>
            <% }else if(lstJobs.deadline > Date.now()){ %>

            <span class="badge badge-pill badge-danger">Tin tuyển dụng đã hết hạn</span>

            <% }else { %>
            <span class="badge badge-pill badge-success">Hoạt động</span>
            <% } %>
          </td>
          <td>
            <div class="btn-group">
              <button
                type="button"
                class="btn btn-info dropdown-toggle"
                data-toggle="dropdown"
                aria-haspopup="true"
                aria-expanded="false"
              >
                Action
              </button>
              <div class="dropdown-menu">
                <a class="dropdown-item" href="/Jobs/Detail/<%= lstJobs._id %>">Xem chi tiết</a>
                <% if(new Date(lstJobs.deadline) < Date.now()) { %>
                  <a class="dropdown-item" href="/Jobs/lockJobs/<%= lstJobs._id %>">Khóa/ Cảnh báo về tin tuyển dụng</a>
              <% } %>
              </div>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
      <% if (currentPage > 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=1&limit=<%= limit %>&search=<%= search %>" aria-label="First">
            <span aria-hidden="true">&laquo;&laquo;</span>
          </a>
        </li>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>" aria-label="Previous">
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>
      <% } %>

      <% for(let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>&search=<%= search %>"><%= i %></a>
        </li>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>" aria-label="Next">
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
        <li class="page-item">
          <a class="page-link" href="?page=<%= totalPages %>&limit=<%= limit %>&search=<%= search %>" aria-label="Last">
            <span aria-hidden="true">&raquo;&raquo;</span>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
</div>
<!-- section container end -->

<%- include('../inc/nav_footer.ejs') %> 
<%- include('../inc/footer.ejs') %>