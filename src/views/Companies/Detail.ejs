<%- include('../inc/header.ejs') %> <%- include('../inc/nav_header.ejs') %>

<style>
    .user-avatar {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 50%;
}

</style>
<div class="col-md-12 col-sm-12">
    
      <div class="form-block">
       
        <div class="form-block-body">
          <div class="mb-3 d-flex justify-content-center" style="flex-direction:column;align-items: center;">
            <label for="avata-user" class="form-label">Logo</label>
            <div class="avatar-upload">
             
              <label for="avata" class="avatar-placeholder">
               <img
  src="<%= companies && companies.company_logo ? (Fcompanies.company_logo) : "https://img.freepik.com/premium-vector/abyssinian-cat-head-avata_73950-151.jpg" %>"
  alt="Avatar"
  id="avatar-preview"
  class="user-avatar"
/>
              </label>
            </div>
          </div>
          <div class="form-group">
            <label>Tên doanh nghiệp: </label>
          <span><%= companies.company_name %></span>
          </div>
          <div class="form-group">
            <label>Mô tả: </label>
            <span><%= companies.company_desc %></span>
           
          </div>
         
          <div class="form-group">
            <label>Địa chỉ: </label>
<span><%= companies.company_address %></span>
           
          </div>
          <div class="form-group">
            <label>Quy mô: </label>
<span><%= companies.company_scale %></span>
          
          </div>
          <div class="form-group">
            <label> Website: </label>
            <span><%= companies.company_website %></span>
           
            
          </div>
          <div class="form-group">
            <label>Chứng chỉ:</label>
            <% if (companies.company_certification) { %>
              
              <a class="btn btn-primary" href="<%= companies.company_certification %>" target="_blank">Xem</a>
            
            <% } else { %>
              <span>Chưa có chứng chỉ</span>
            <% } %>
          </div>

          <div class="form-group">
            <label> Mã số thuế: </label>
            <span><%= companies.taxcode %></span>
           
            
          </div>
          <div class="form-group">
            <label> Trạng thái: </label>
            <% if(companies.active){ %>
              <span class="badge badge-pill badge-success">Đã duyệt</span>
  
              <% }else { %>
              <span class="badge badge-pill badge-danger">Chưa duyệt</span>
  
              <% } %>
           
            
          </div>

         
        </div>
        <% if(!companies.active){ %>
          <button type="button" class="btn btn-danger" >
            
              <a class="dropdown-item" href="/compamies/active/<%= companies._id %>">Duyệt doanh nghiệp</a>
          
          </button>
          <% }%>
      </div>
      
      
  </div>
  
  <%- include('../inc/nav_footer.ejs') %> <%- include('../inc/footer.ejs') %>