<span class="span">Biểu đồ ứng tuyển của người lao động năm 2024</span>

                <div id="chartdiv"></div>

                </div>
<%- include('./BieuDoTinTuyenDung.ejs') %>
<%- include('./BieuDoTangTruongDoanhNghiep.ejs') %>
              

                </div>
