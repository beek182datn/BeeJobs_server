<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <!-- Styles -->
    <style>
        #chartdivDT {
            width: 100%;
            height: 500px;
        }
    </style>
    <!-- Resources -->
    <script src="https://cDT.amcharts.com/lib/5/index.js"></script>
    <script src="https://cDT.amcharts.com/lib/5/xy.js"></script>
    <script src="https://cDT.amcharts.com/lib/5/themes/Animated.js"></script>
</head>
<body>
    <!-- HTML -->
    <span id="TieuDeDoanhThu" class="span">Biểu đồ doanh thu năm 2024</span>

    <input type="date" id="startDateSelector" />
    <input type="date" id="endDateSelector" />

    <select id="yearSelectorDoanhThu">
        <option value="">Tất cả các năm</option>
        <% data.moneyDeposits.forEach(item => { %>
            <option value="<%= item.year %>"><%= item.year %></option>
        <% }) %>
    </select>


    <div id="chartdivDT" data-cash-money='<%= JSON.stringify(data.moneyDeposits) %>'></div>

    <!-- Chart code -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Get data from data attribute
            var chartDiv = document.getElementById('chartdivDT');
            var dataDTFirst = JSON.parse(chartDiv.getAttribute('data-cash-money'));
            var rootDT;
function createChartDT(dataDT){

  
    if (rootDT) {
        rootDT.dispose();
    }
            // Set data
            am5.ready(function() {
                // Create root element
                rootDT = am5.Root.new("chartdivDT");

                // Set themes
                rootDT.setThemes([
                    am5themes_Animated.new(rootDT)
                ]);

                // Create chart
                var chartDT = rootDT.container.children.push(am5xy.XYChart.new(rootDT, {
                    panX: true,
                    panY: true,
                    wheelX: "panX",
                    wheelY: "zoomX",
                    pinchZoomX: true,
                    paddingLeft: 0,
                    paddingRight: 1
                }));

                // Add cursor
                var cursor = chartDT.set("cursor", am5xy.XYCursor.new(rootDT, {}));
                cursor.lineY.set("visible", false);

                // Create axes
                var xRenderer = am5xy.AxisRendererX.new(rootDT, {
                    minGridDistance: 30,
                    minorGridEnabled: true
                });

                xRenderer.labels.template.setAll({
                    rotation: -90,
                    centerY: am5.p50,
                    centerX: am5.p100,
                    paddingRight: 15
                });

                xRenderer.grid.template.setAll({
                    location: 1
                });

                var xAxis = chartDT.xAxes.push(am5xy.CategoryAxis.new(rootDT, {
                    maxDeviation: 0.3,
                    categoryField: "month",
                    renderer: xRenderer,
                    tooltip: am5.Tooltip.new(rootDT, {})
                }));

                var yRenderer = am5xy.AxisRendererY.new(rootDT, {
                    strokeOpacity: 0.1
                });

                var yAxis = chartDT.yAxes.push(am5xy.ValueAxis.new(rootDT, {
                    maxDeviation: 0.3,
                    renderer: yRenderer
                }));

                // Create series
                var series = chartDT.series.push(am5xy.ColumnSeries.new(rootDT, {
                    name: "Series 1",
                    xAxis: xAxis,
                    yAxis: yAxis,
                    valueYField: "totalAmount",
                    sequencedInterpolation: true,
                    categoryXField: "month",
                    tooltip: am5.Tooltip.new(rootDT, {
                        labelText: "{valueY} USD"
                    })
                }));

                series.columns.template.setAll({ cornerRadiusTL: 5, cornerRadiusTR: 5, strokeOpacity: 0 });
                series.columns.template.adapters.add("fill", function(fill, target) {
                    return chartDT.get("colors").getIndex(series.columns.indexOf(target));
                });

                series.columns.template.adapters.add("stroke", function(stroke, target) {
                    return chartDT.get("colors").getIndex(series.columns.indexOf(target));
                });

                xAxis.data.setAll(dataDT);
                series.data.setAll(dataDT);

                // Make stuff animate on load
                series.appear(1000);
                chartDT.appear(1000, 100);
            }); // end am5.ready()
       
       
        }
        createChartDT(dataDTFirst);
        var getTieuDeJobsDT = document.getElementById("TieuDeDoanhThu")
        $('#yearSelectorDoanhThu').change(function() {
    var selectedYear = $(this).val();

    if (selectedYear === "") {
        createChartDT(dataDTFirst); // Hiển thị dữ liệu tất cả các năm
        getTieuDeJobsDT.innerHTML = `Biểu đồ ứng tuyển của người lao động các năm`;

    } else {
        $.ajax({
            url: `/Dashboard/getMoneyDepositsByYear/${selectedYear}`,
            method: 'GET',
            success: function(data) {
                createChartDT(data); // Cập nhật biểu đồ tiền gửi với dữ liệu mới
        getTieuDeJobsDT.innerHTML = `Biểu đồ ứng tuyển của người lao động năm ${selectedYear}`;

            }
        });
    }
});




$('#startDateSelector, #endDateSelector').change(function() {
    var startDate = $('#startDateSelector').val();
    var endDate = $('#endDateSelector').val();

    if (startDate === "" || endDate === "") {
        createChartDT(dataDTFirst); // Hiển thị dữ liệu tất cả các năm
        getTieuDeJobsDT.innerHTML = `Biểu đồ ứng tuyển của người lao động các ngày`;
    } else {
        $.ajax({
            url: `/Dashboard/getMoneyDepositsByDateRange/${startDate}/${endDate}`,
            method: 'GET',
            success: function(data) {
                createChartDT(data); // Cập nhật biểu đồ tiền gửi với dữ liệu mới
                getTieuDeJobsDT.innerHTML = `Biểu đồ ứng tuyển của người lao động từ ngày ${startDate} đến ngày ${endDate}`;
            }
        });
    }
});

        });
    </script>
</body>
</html>
