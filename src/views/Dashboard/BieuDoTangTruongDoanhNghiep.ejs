<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <!-- Styles -->
    <style>
        #chartdivDN {
            width: 100%;
            height: 500px;
        }
    </style>
    <!-- Resources -->
    <script src="https://cdn.amcharts.com/lib/5/index.js"></script>
    <script src="https://cdn.amcharts.com/lib/5/xy.js"></script>
    <script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>
</head>

<body>
    <!-- HTML -->
    <span id="TieuDeNam" class="span">Biểu đồ tăng trưởng doanh nghiệp qua các năm</span>
    <select id="yearSelector">
        <option value="">Tất cả các năm</option>
        <% data.companyGrowthByYear.forEach(item => { %>
            <option value="<%= item.year %>"><%= item.year %></option>
        <% }) %>
    </select>
    
    <div id="chartdivDN" data-company-growth='<%= JSON.stringify(data.companyGrowthByYear) %>'></div>

    <!-- Chart code -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Get data from data attribute
            var chartDiv = document.getElementById('chartdivDN');
            var dataDNFirst = JSON.parse(chartDiv.getAttribute('data-company-growth'));
            var rootDN;
            function createChartDN(dataDN) {
                
                if (rootDN) {
        rootDN.dispose();
    }
            // Set data
            am5.ready(function() {
                // Create root element
                rootDN = am5.Root.new("chartdivDN");

                // Set themes
                rootDN.setThemes([
                    am5themes_Animated.new(rootDN)
                ]);

                // Create chart
                var chartDN = rootDN.container.children.push(am5xy.XYChart.new(rootDN, {
                    panX: true,
                    panY: true,
                    wheelX: "panX",
                    wheelY: "zoomX",
                    pinchZoomX: true,
                    paddingLeft: 0,
                    paddingRight: 1
                }));

                // Add cursor
                var cursor = chartDN.set("cursor", am5xy.XYCursor.new(rootDN, {}));
                cursor.lineY.set("visible", false);

                // Create axes
                var xRenderer = am5xy.AxisRendererX.new(rootDN, {
                    minGridDistance: 30,
                    minorGridEnabled: true
                });

                xRenderer.labels.template.setAll({
                    rotation: -90,
                    centerY: am5.p50,
                    centerX: am5.p100,
                    paddingRight: 15
                });

                xRenderer.grid.template.setAll({
                    location: 1
                });

                var xAxis = chartDN.xAxes.push(am5xy.CategoryAxis.new(rootDN, {
                    maxDeviation: 0.3,
                    categoryField: "month",
                    renderer: xRenderer,
                    tooltip: am5.Tooltip.new(rootDN, {})
                }));

                var yRenderer = am5xy.AxisRendererY.new(rootDN, {
                    strokeOpacity: 0.1
                });

                var yAxis = chartDN.yAxes.push(am5xy.ValueAxis.new(rootDN, {
                    maxDeviation: 0.3,
                    renderer: yRenderer
                }));

                // Create series
                var series = chartDN.series.push(am5xy.ColumnSeries.new(rootDN, {
                    name: "Series 1",
                    xAxis: xAxis,
                    yAxis: yAxis,
                    valueYField: "value",
                    sequencedInterpolation: true,
                    categoryXField: "month",
                    tooltip: am5.Tooltip.new(rootDN, {
                        labelText: "{valueY}"
                    })
                }));

                series.columns.template.setAll({ cornerRadiusTL: 5, cornerRadiusTR: 5, strokeOpacity: 0 });
                series.columns.template.adapters.add("fill", function(fill, target) {
                    return chartDN.get("colors").getIndex(series.columns.indexOf(target));
                });

                series.columns.template.adapters.add("stroke", function(stroke, target) {
                    return chartDN.get("colors").getIndex(series.columns.indexOf(target));
                });

                xAxis.data.setAll(dataDN);
                series.data.setAll(dataDN);

                // Make stuff animate on load
                series.appear(1000);
                chartDN.appear(1000, 100);
            }); // end am5.ready()
            }
        createChartDN(dataDNFirst);

        var tieudenam = document.getElementById("TieuDeNam")
        $('#yearSelector').change(function() {
            var selectedYear = $(this).val();

            if (selectedYear === "") {
                // Hiển thị dữ liệu tất cả các năm
                createChartDN(dataDNFirst)
                tieudenam.innerText = `Biểu đồ tăng trưởng doanh nghiệp qua các năm`;
            } else {
                // Gọi API để lấy dữ liệu của năm được chọn
                $.ajax({
    url: `/Dashboard/getdatayearDN/${selectedYear}`,
    method: 'GET',
    success: function(data) {
        console.log(data, 'Dữ liệu từ API');

        createChartDN(data);
        tieudenam.innerText = `Biểu đồ tăng trưởng doanh nghiệp năm ${selectedYear}`;
    },
    error: function(error) {
        console.error('Lỗi khi gọi API:', error);
    }
});}
            });
        });
       
    </script>
</body>
</html>
