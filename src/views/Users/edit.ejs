<%- include('../inc/header.ejs') %> <%- include('../inc/nav_header.ejs') %>

<style>
    .user-avatar {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 50%;
}

</style>
<div class="col-md-12 col-sm-12">
    <form method="post" action="/Users/editUser/<%= user._id %>" enctype="multipart/form-data" >
      <div class="form-block">
       
        <div class="form-block-body">
          <div class="mb-3 d-flex justify-content-center" style="flex-direction:column;align-items: center;">
            <label for="avata-user" class="form-label">Avata</label>
            <div class="avatar-upload">
              <input type="file" name="avata_profile" id="avata" class="d-none"  onchange="showImagePreview(this)" />
              <label for="avata" class="avatar-placeholder">
               <img
  src="<%= user && user.avata ? ("http://beejobs.io.vn:14307" + user.avata) : "https://img.freepik.com/premium-vector/abyssinian-cat-head-avata_73950-151.jpg" %>"
  alt="Avatar"
  id="avatar-preview"
  class="user-avatar"
/>
              </label>
            </div>
          </div>
          <div class="form-group">
            <label>UserName</label>
            <input type="text" class="form-control" id="accout_name" name="accout_name" placeholder="Tên đăng nhập" value="<%= user.accout_name %>"
              required readonly>
          </div>
          <div class="form-group">
            <label>Email</label>

            <input type="email" class="form-control" id="email" name="email" placeholder="Email" readonly value="<%= user.email %>"
              required>
          </div>
         
          <div class="form-group">
            <label>Họ và tên</label>

            <input type="text" class="form-control" id="full_name" name="full_name" value="<%= user.full_name %>"
              placeholder="Họ và tên" required>
          </div>
          <div class="form-group">
            <label>Số điện thoại</label>

            <input type="number" class="form-control" id="phone" name="phone"
            value="<%= user.phone %>"
              placeholder="Mobile Number" required>
          </div>
          <div class="form-group">
            <label> Giới tính</label>
           <div class="col-xl-8 col-lg-8 col-md-8 ">
            
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="gender" id="inlineRadio1"
                                                    value="Nam" checked>
                                                <label class="form-check-label" for="inlineRadio1">Nam</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="gender" id="inlineRadio2"
                                                    value="Nữ">
                                                <label class="form-check-label" for="inlineRadio2">Nữ</label>
                                            </div>
                                        
                                        </div>
            
          </div>

         
        </div>
      </div>
      <button type="button"  class="btn btn-secondary" ><a href="/Users/index">Quay lại</a> </button>
      <button type="submit" class="btn btn-primary">Sửa</button>
      </form>
  </div>

  <script>
    function showImagePreview(input) {
      const avatarPreview = document.getElementById("avata-preview");
      const selectedFile = input.files[0];
      
      if (selectedFile) {
        const reader = new FileReader();
        
        reader.onload = function(event) {
          avatarPreview.src = event.target.result;
        };
        
        reader.readAsDataURL(selectedFile);
      }
    }
  </script>
  <%- include('../inc/nav_footer.ejs') %> <%- include('../inc/footer.ejs') %>