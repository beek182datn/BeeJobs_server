<%- include('../inc/header.ejs') %> <%- include('../inc/nav_header.ejs') %>

<style>
    .user-avatar {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 50%;
}

</style>
<div class="col-md-12 col-sm-12">
    
      <div class="form-block">
       
        <div class="form-block-body">
          <div class="mb-3 d-flex justify-content-center" style="flex-direction:column;align-items: center;">
            <label for="avata-user" class="form-label">Avata</label>
            <div class="avatar-upload">
             
              <label for="avata" class="avatar-placeholder">
               <img
  src="<%= user && user.avata ? (user.avata) : "https://img.freepik.com/premium-vector/abyssinian-cat-head-avata_73950-151.jpg" %>"
  alt="Avatar"
  id="avatar-preview"
  class="user-avatar"
/>
              </label>
            </div>
          </div>
          <div class="form-group">
            <label>Tên đăng nhập: </label>
          <span><%= user.accout_name %></span>
          </div>
          <div class="form-group">
            <label>Email: </label>
            <span><%= user.email %></span>
           
          </div>
         
          <div class="form-group">
            <label>Họ và tên: </label>
<span><%= user.full_name %></span>
           
          </div>
          <div class="form-group">
            <label>Số điện thoại: </label>
<span><%= user.phone %></span>
          
          </div>
          <div class="form-group">
            <label> Giới tính: </label>
            <span><%= user.gender == "Nam"? "Nam" : "Nữ" %></span>
           
            
          </div>

         
        </div>
      </div>
      

  </div>

 
  <%- include('../inc/nav_footer.ejs') %> <%- include('../inc/footer.ejs') %>