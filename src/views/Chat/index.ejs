                                            <li class='chat-left'>
                                                <div class='chat-avatar'>
                                                    <img src="img/user3.png" alt="Low Price Admin Templates" />
                                                    <div class='chat-name'>Russell</div>
                                                </div>
                                                <div class='chat-text'>Actually everything was fine.<br />I'm very excited to show this to
                                                    our team.</div>
                                                <div class='chat-hour'>07:00 <span class='icon-done_all'></span></div>
                                            </li>
                                        </ul>
                                        <div class="form-group mt-3 mb-0">
                                            <textarea class="form-control" rows="1" placeholder="Type your message here..."></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Row end -->
                        </div>
                    </div>
                </div>
