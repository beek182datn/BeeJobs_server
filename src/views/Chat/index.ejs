			<!-- BEGIN .main-heading -->
            <header class="custom-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="page-title">
                                <h3>Chat App</h3>
                                <h6 class="sub-heading">Welcome to Kingfisher Admin Template</h6>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12"></div>
                    </div>
                </div>
            </header>
